<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <IsBindingProject>true</IsBindingProject>
    <PackOnBuild>true</PackOnBuild>
    <GeneratePackageOnBuild>$(PackOnBuild)</GeneratePackageOnBuild>
    <PackageId>OpenCvSdk.iOS</PackageId>
    <PackageVersion>5.1.0</PackageVersion>
    <Authors>Howard Good</Authors>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <Owners>https://www.nuget.org/profiles/v-hogood</Owners>
    <RepositoryUrl>https://github.com/opencv/opencv/tree/5.x/platforms/ios</RepositoryUrl>
    <PackageProjectUrl>https://github.com/v-hogood/OpenCvSdk</PackageProjectUrl>
    <Summary>.iOS .NET bindings for OpenCV SDK Library.</Summary>
    <PackageTags>maui xamarin ios opencv</PackageTags>
    <Title>OpenCvSdk.iOS</Title>
    <Description>iOS .NET bindings for OpenCV SDK Library.</Description>
    <NoWarn>0108;0114;8767</NoWarn>
    <LinkWithSwiftSystemLibraries>true</LinkWithSwiftSystemLibraries>
  </PropertyGroup>
  <ItemGroup>
    <ObjcBindingApiDefinition Include="ApiDefinition.cs" />
    <ObjcBindingCoreSource Include="StructsAndEnums.cs" />
  </ItemGroup>
  <ItemGroup>
    <NativeReference Include="opencv2.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
      <ForceLoad>True</ForceLoad>
      <IsCxx>True</IsCxx>
      <LinkerFlags>-ObjC</LinkerFlags>
    </NativeReference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="opencv2.framework/**/*" />
    <None Remove="opencv*framework.zip" />
    <None Include="LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
  <Target Name="DownloadFile" BeforeTargets="BeforeBuild">
    <DownloadFile SourceUrl="https://raw.githubusercontent.com/opencv/opencv/refs/heads/5.x/LICENSE" DestinationFolder="." />
    <DownloadFile SourceUrl="https://github.com/opencv/opencv/releases/download/5.1.0/opencv-5.1.0-ios-framework.zip" DestinationFolder="." />
    <Exec Command="tar -xf opencv-5.1.0-ios-framework.zip --strip-components=2 -s/A/opencv2.framework/ opencv2.framework/Versions/A" />
    <Exec Command="sed -i '' '97s/ NS_SWIFT_NAME.*/;/' opencv2.framework/Headers/LightGlueMatcher.h" />
    <Exec Command="unzip -o opencv-5.1.0-ios.zip" />
  </Target>
</Project>
